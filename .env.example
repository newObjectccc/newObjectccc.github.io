# 部署环境变量模板 —— 复制为 .env.production 并填入真实值（.env* 均已 gitignore）
#
# 真实值只应保存在：本地 .env.production 与服务器 /opt/vesper/.env。
# deploy-production.sh 默认保留服务器现有 .env；
# 只有显式 RUN_SYNC_ENV=true 时，才把本地 .env.production 同步为服务器 .env。

# ---- 门禁 ----
# cookie 签名密钥：openssl rand -hex 32
GATE_COOKIE_SECRET=
# 朋友答案（如 jinchaodan）的 SHA-256：printf '<答案小写>' | sha256sum
GATE_FRIEND_HASH=
# 主人答案的 SHA-256（代码统一按小写比较，注意先转小写再哈希）
GATE_OWNER_HASH=

# ---- Waline ----
# 管理端会话密钥：openssl rand -hex 32
JWT_TOKEN=

# ---- AI（OpenRouter key，经 HK 出海代理转发；GEMINI 对该账号区域封锁，勿用）----
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://proxy-hk.qyqmedu.com/v1
# proxy-hk edge-proxy 的访问密钥（与 daka 同一个 PROXY_SECRET）
EDGE_PROXY_SECRET=
# 语音成文（FunASR 转写 + 该模型润色）
SCRIBE_MODEL=deepseek/deepseek-v4-pro
# AI 插图（需视觉模型）
ILLUSTRATE_MODEL=qwen/qwen2.5-vl-72b-instruct

# ---- 语音 ----
# 语音识别（复用 vesper-refactory-funasr 容器）
FUNASR_WS_URL=ws://host.docker.internal:10095
# 朗读（compose 内网 tts 服务，镜像复用 qyqm-local-tts:1.0.0）
TTS_BASE_URL=http://tts:8000

# ---- COS 图片（复用 next-monorepo 同 bucket，vesper-diary/ 前缀）----
COS_SECRET_ID=
COS_SECRET_KEY=
COS_BUCKET=
COS_REGION=
COS_PUBLIC_BASE_URL=
COS_CDN_URL=
